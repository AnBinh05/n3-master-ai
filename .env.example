# Database Configuration (PostgreSQL / Supabase / Neon / SQLite)
DATABASE_URL="postgresql://postgres:password@localhost:5432/n3_master_ai?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-random-key-change-in-production-min-32-chars"

# OAuth Credentials (Optional for local testing)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# AI Provider Configuration (Hybrid AI: Ollama Local Free / Google Gemini Free / OpenAI)
# 1. Local AI Free (Ollama): Chạy Gemma 2 hoặc Qwen 2.5 trực tiếp trên máy
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma2"

# 2. Google Gemini API Key (Miễn phí từ Google AI Studio)
GEMINI_API_KEY=""

# 3. OpenAI Key
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Stripe Configuration
STRIPE_API_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_PRO_PRICE_ID="price_1234567890"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
